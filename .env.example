NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizreplyai
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/bizreplyai

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional but recommended in production. Without REDIS_URL, the API uses a bounded in-memory cache.
REDIS_URL=
CACHE_MAX_ENTRIES=5000
CACHE_SWEEP_INTERVAL_SECONDS=60

RESEND_API_KEY=
EMAIL_FROM="BizReply AI <noreply@yourdomain.com>"
WAITLIST_CONFIRMATION_URL=https://bizreplyhq.com/waitlist/confirm
WAITLIST_CONFIRMATION_EXPIRY_HOURS=24
WAITLIST_RESEND_COOLDOWN_SECONDS=60

WHATSAPP_PROVIDER_MODE=mock
ENABLE_DEV_TOOLS=true
MOCK_WHATSAPP_FORCE_FAILURE=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v20.0

# Keep the current key stable. During rotation, change the key ID/key and retain old keys in the JSON keyring.
WHATSAPP_CREDENTIAL_KEY_ID=primary
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
WHATSAPP_CREDENTIAL_DECRYPTION_KEYS=

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_EMBEDDING_DIMENSIONS=1536
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,meta-llama/llama-3.1-8b-instruct
OPENROUTER_TIMEOUT_MS=30000

OPENROUTER_APP_NAME=BizReply AI
OPENROUTER_APP_URL=
AI_REPLY_ENABLED=true
AI_MIN_CONFIDENCE=0.75
AI_AUTO_CONFIRM_MIN_CONFIDENCE=0.85
PREMIUM_APPOINTMENT_AUTO_CONFIRM_ENABLED=false
AI_MAX_CONTEXT_MESSAGES=12
AI_MAX_BUSINESS_CONTEXT_TOKENS=6000

KNOWLEDGE_BASIC_ASSET_LIMIT=5
KNOWLEDGE_PLUS_ASSET_LIMIT=50
KNOWLEDGE_PREMIUM_ASSET_LIMIT=200
KNOWLEDGE_BASIC_AI_DRAFT_LIMIT=0
KNOWLEDGE_PLUS_AI_DRAFT_LIMIT=20
KNOWLEDGE_PREMIUM_AI_DRAFT_LIMIT=100
KNOWLEDGE_BASIC_MONTHLY_AI_ANALYSIS_REQUEST_LIMIT=30
KNOWLEDGE_PLUS_MONTHLY_AI_ANALYSIS_REQUEST_LIMIT=150
KNOWLEDGE_PREMIUM_MONTHLY_AI_ANALYSIS_REQUEST_LIMIT=750
KNOWLEDGE_BASIC_PDF_UPLOAD_LIMIT=10
KNOWLEDGE_PLUS_PDF_UPLOAD_LIMIT=50
KNOWLEDGE_PREMIUM_PDF_UPLOAD_LIMIT=250
KNOWLEDGE_BASIC_STORAGE_LIMIT_BYTES=104857600
KNOWLEDGE_PLUS_STORAGE_LIMIT_BYTES=1073741824
KNOWLEDGE_PREMIUM_STORAGE_LIMIT_BYTES=5368709120
KNOWLEDGE_UPLOAD_MAX_BYTES=10485760
KNOWLEDGE_STORAGE_DIR=storage/knowledge
AWS_REGION=eu-central-1
# Bucket names must contain exactly the declared environment token.
AWS_S3_BUCKET_ENVIRONMENT=development
AWS_S3_BUCKET=bizreply-development-files-<aws-account-id>-eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_SIGNED_URL_TTL_SECONDS=900
# Production must use clamav and a reachable private clamd endpoint.
KNOWLEDGE_MALWARE_SCANNER_MODE=disabled
KNOWLEDGE_CLAMAV_HOST=
KNOWLEDGE_CLAMAV_PORT=3310
KNOWLEDGE_CLAMAV_TIMEOUT_MS=30000
KNOWLEDGE_DOCUMENT_WORKER_ENABLED=true
KNOWLEDGE_DOCUMENT_WORKER_INTERVAL_SECONDS=30
KNOWLEDGE_DOCUMENT_WORKER_BATCH_SIZE=10
KNOWLEDGE_DOCUMENT_WORKER_STALE_SECONDS=600
KNOWLEDGE_DOCUMENT_WORKER_MAX_ATTEMPTS=5
KNOWLEDGE_DOCUMENT_STALE_UPLOAD_MINUTES=10
KNOWLEDGE_DOCUMENT_RETENTION_DAYS=30
KNOWLEDGE_DOCUMENT_CLEANUP_BATCH_SIZE=10
KNOWLEDGE_DOCUMENT_CLEANUP_MAX_ATTEMPTS=10
KNOWLEDGE_DOCUMENT_CLEANUP_STALE_SECONDS=900
