{
  "name": "bizreplyai-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "description": "BizReply AI SaaS backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tests/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test:premium-follow-up-decision": "tsx --test tests/follow-up-premium-decision-context.test.ts",
    "test:premium-follow-up-validation": "tsx --test tests/follow-up-premium-lifecycle-policy.test.ts",
    "test:premium-follow-up-generation": "tsx --test tests/follow-up-premium-message-generation.test.ts",
    "test:premium-follow-up-execution": "tsx --test tests/follow-up-premium-execution-policy.test.ts",
    "test:knowledge-ingestion": "tsx --test tests/knowledge-document-ingestion-policy.test.ts",
    "test:knowledge-worker": "tsx --test tests/knowledge-document-worker-policy.test.ts",
    "test:knowledge-analysis": "tsx --test tests/knowledge-document-analysis-policy.test.ts",
    "test:knowledge-embeddings": "tsx --test tests/knowledge-embedding-sync.test.ts",
    "test:knowledge-review": "tsx --test tests/knowledge-document-review-policy.test.ts",
    "test:knowledge-governance": "tsx --test tests/knowledge-document-governance-policy.test.ts",
    "test:knowledge-governance-resolution": "tsx --test tests/knowledge-governance-resolution-policy.test.ts",
    "test:knowledge-runtime-refresh": "tsx --test tests/knowledge-runtime-refresh-policy.test.ts",
    "test:knowledge-runtime-governance": "tsx --test tests/knowledge-runtime-governance-policy.test.ts tests/knowledge-runtime-guard-loading.test.ts",
    "test:knowledge-context-governance": "tsx --test tests/knowledge-structured-context-policy.test.ts",
    "test:knowledge-settings-reconciliation": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-settings-reconciliation.integration.test.ts",
    "test:knowledge-governance-resolution-integration": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-governance-resolution.integration.test.ts",
    "test:knowledge-tenant-constraints": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-document-tenant-constraints.integration.test.ts",
    "test:knowledge-upload-idempotency": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-document-upload-idempotency.integration.test.ts",
    "test:knowledge-quota-concurrency": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-hub-quota-concurrency.integration.test.ts",
    "test:knowledge-version-replacement": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-document-version-replacement.integration.test.ts",
    "test:knowledge-storage-cleanup": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-document-storage-cleanup.integration.test.ts",
    "test:knowledge-storage-usage": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-storage-usage.integration.test.ts",
    "test:knowledge-storage-migration": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/knowledge-storage-migration.integration.test.ts",
    "test:storage-environment-policy": "tsx --test tests/storage-environment-policy.test.ts",
    "test:business-invitations": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/business-invitation-lifecycle.integration.test.ts",
    "test:waitlist": "tsx --test tests/waitlist-policy.test.ts",
    "test:waitlist-integration": "RUN_DATABASE_INTEGRATION_TESTS=true tsx --test tests/waitlist-lifecycle.integration.test.ts",
    "whatsapp:credentials:migrate": "tsx prisma/migrate-whatsapp-credentials.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "test:demo": "tsx --test tests/demo-session.test.ts tests/demo-website.test.ts tests/demo-setup.test.ts tests/demo-session.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/lib-storage": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.1.0",
    "htmlparser2": "^10.1.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "redis": "^6.0.1",
    "resend": "^6.0.2",
    "robots-parser": "^3.0.1",
    "slugify": "^1.6.6",
    "yauzl": "3.2.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.24",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "2.4.5",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "yazl": "3.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
